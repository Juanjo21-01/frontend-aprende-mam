# Consumo del backend Laravel. Se usa SOLO durante `npm run build`: el sitio compilado no
# hace ni una llamada a la API desde el navegador.
#
# Copiar a `.env` y rellenar para compilar con datos frescos. Sin estas variables el build
# funciona igual, con la copia local de `docs/vocabulario.json`, y lo avisa por consola.
#
# En Netlify van como variables de entorno del sitio, no en un archivo.

# Raíz de los endpoints de exportación, sin barra final. De ahí cuelgan `/version` y
# `/vocabulario.json`.
EXPORT_URL=http://localhost:8000/api/v1/export

# El mismo valor que `EXPORT_TOKEN` en el `.env` del backend. Viaja como `Bearer`.
# Si `EXPORT_URL` está definida y este token falta o no coincide, el build se detiene: mejor
# un despliegue fallido que un diccionario viejo publicado en silencio.
EXPORT_TOKEN=
