---
/**
 * El botón de un PDF: el de un documento de materiales y el adjunto de una página de cultura o
 * de base legal.
 *
 * Un PDF puede vivir en el sitio o en otro (Google Drive, por ejemplo). El atributo `download` solo
 * lo respeta el navegador con archivos del mismo origen, y el botón no puede prometer una
 * descarga que decide un tercero: con uno externo dice «Abrir», se abre en otra pestaña para no
 * sacar al usuario del sitio, y avisa adónde sale.
 *
 * El PDF no se precachea (CLAUDE.md): se baja cuando se toca, y el tamaño va por delante para que
 * la decisión de gastar datos sea del usuario.
 */
interface Props {
  url: string;
  tamanoKb: number | null;
}

const { url, tamanoKb } = Astro.props;
const base = import.meta.env.BASE_URL;

/** `820` → «820 KB»; `2300` → «2.2 MB». */
function tamano(kb: number): string {
  return kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${kb} KB`;
}

const externo = url.startsWith('https://');
/** Las rutas del sitio llevan el prefijo; las https van tal cual. */
const destino = url.startsWith('/') ? `${base.replace(/\/$/, '')}${url}` : url;
const sitio = externo ? new URL(url).hostname.replace(/^www\./, '') : null;

/*
 * El tamaño y adónde sale van dentro del propio botón, en una segunda línea, y no como una nota
 * gris suelta debajo: así se leen como una sola cosa —qué es, cuánto pesa, qué necesita— antes de
 * tocar. La línea va en el mismo texto del campo, no en gris, para no perder contraste.
 */
const detalle = [
  tamanoKb !== null ? tamano(tamanoKb) : null,
  sitio,
  externo ? 'Necesita internet' : null,
].filter(Boolean);
---

<a
  href={destino}
  download={externo ? undefined : ''}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener noreferrer' : undefined}
  class="tocable mt-3 flex min-h-14 w-full max-w-md items-center gap-3 rounded-2xl bg-negro-campo px-4 py-3 text-negro-texto no-underline hover:bg-papel-hondo [--tocable-sombra:var(--color-negro)]"
>
  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"></path>
    <path d="M14 3v5h5M9 13h6M9 17h4"></path>
  </svg>
  <span class="min-w-0 grow">
    <span class="block font-bold leading-snug">{externo ? 'Abrir PDF' : 'Descargar PDF'}</span>
    {detalle.length > 0 && <span class="block text-sm leading-snug">{detalle.join(' · ')}</span>}
    {externo && <span class="sr-only">, se abre en otra pestaña</span>}
  </span>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
    {externo ? <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path> : <path d="M12 4v11m-5-5 5 5 5-5M5 20h14"></path>}
  </svg>
</a>
