---
import IconoSeccion from './IconoSeccion.astro';
import { ESTILO_RUMBO, type Seccion } from '@/data/secciones';

/*
 * La cabecera de una página de sección: el ícono de la sección en el campo de su rumbo, el
 * título y, si la página cuelga de otra, el enlace para volver.
 *
 * Junto con la franja que pinta el layout, es lo único de color en la cabecera: el fondo sigue
 * siendo papel. Encabezados de color a pantalla completa cansan y le quitan contraste al texto
 * (docs/rediseno-ui.md, «Páginas interiores»).
 *
 * El título va por la ranura `titulo` cuando lleva marcado (una palabra en Mam con su `lang`),
 * y por la propiedad cuando es texto llano. La ranura por defecto es la entradilla.
 */
interface Props {
  seccion: Seccion;
  titulo?: string;
  /** Página de la que cuelga esta, para el enlace de vuelta. Sin él, no se pinta. */
  volver?: { href: string; texto: string };
}

const { seccion, titulo, volver } = Astro.props;

const estilo = ESTILO_RUMBO[seccion.rumbo];
---

<header>
  {
    volver && (
      <a
        href={volver.href}
        class="mb-3 inline-flex min-h-11 items-center gap-1 text-base text-tinta-suave underline"
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 5-7 7 7 7"></path>
        </svg>
        {volver.texto}
      </a>
    )
  }

  <div class="flex items-center gap-3">
    <span
      class:list={['grid size-12 shrink-0 place-items-center rounded-xl', estilo.activo]}
      aria-hidden="true"
    >
      <IconoSeccion d={seccion.icono} tamano={26} />
    </span>
    <h1 class="min-w-0 text-3xl leading-tight [overflow-wrap:anywhere] md:text-4xl">
      <slot name="titulo">{titulo}</slot>
    </h1>
  </div>

  {
    Astro.slots.has('default') && (
      <div class="mt-3 max-w-[68ch] text-tinta-suave">
        <slot />
      </div>
    )
  }
</header>
