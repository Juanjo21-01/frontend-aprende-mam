---
/**
 * El botón «Descargar esta lección para usar sin internet» de CLAUDE.md.
 *
 * La decisión de gastar datos es del usuario, no de la aplicación: por eso es un botón y no algo
 * que se haga solo al abrir la página. Guarda en la caché `aprendemam-lecciones` las imágenes de
 * esta página, y el service worker las sirve de ahí (ver `responderImagen`). Es una caché aparte
 * de la de imágenes bajo demanda porque ésa se poda al llegar a su tope, y una lección que el
 * usuario pidió guardar no puede desaparecer porque abrió otras.
 *
 * Nunca incluye el video: el externo no funciona sin conexión y arrastra cientos de KB.
 *
 * Solo imágenes del propio dominio. El service worker no intercepta lo de otro origen (regla 4),
 * así que guardarlas aquí no serviría de nada y el botón mentiría.
 *
 * Sin React: es un script de unas líneas. Una isla le costaría a cada página de contenido los
 * 52 KB de React solo para un botón.
 */
interface Props {
  /** Cuántas imágenes del propio dominio tiene la página. Con cero, no se pinta el botón. */
  cantidad: number;
}

const { cantidad } = Astro.props;
---

{
  cantidad > 0 && (
    <div
      class="mt-8 rounded-2xl bg-papel-hondo p-5"
      data-leccion-descarga
      data-cantidad={cantidad}
    >
      <h2 class="mb-3 text-xl">Guardar para leer sin señal</h2>
      <button
        disabled
        aria-describedby="estado-descarga"
        type="button"
        class="tocable min-h-12 rounded-2xl border-2 border-borde bg-papel px-4 py-2 font-bold text-tinta hover:bg-papel-hondo disabled:shadow-none"
      >
        Descargar esta lección para usar sin internet
      </button>
      <div class="mt-3 flex items-start gap-2 text-base text-tinta-suave" role="status" aria-atomic="true" id="estado-descarga">
        <svg viewBox="0 0 24 24" width="24" height="24" class="shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path data-icono="info" d="M12 8h.01M12 12v5M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" />
          <path data-icono="exito" style="display:none" d="m5 12 4 4L19 6" />
          <path data-icono="error" style="display:none" d="m7 7 10 10M17 7 7 17" />
        </svg>
        <p data-estado>Guarda {cantidad === 1 ? 'la imagen' : `las ${cantidad} imágenes`} de esta página. Gasta datos solo cuando lo pides. Los videos no se guardan.</p>
      </div>
      <noscript><p class="mt-3 text-base">Activa JavaScript para guardar las imágenes. Puedes seguir leyendo esta página.</p></noscript>
    </div>
  )
}

<script>
  import { guardarImagenes } from '@/data/descarga-leccion';
  const CACHE = 'aprendemam-lecciones';
  const caja = document.querySelector<HTMLElement>('[data-leccion-descarga]');
  if (caja) {
    const boton = caja.querySelector('button')!;
    const estado = caja.querySelector<HTMLElement>('[data-estado]')!;
    const iconos = caja.querySelectorAll<SVGElement>('[data-icono]');
    let ocupada = false;
    const direcciones = () => [...new Set(
      [...document.querySelectorAll<HTMLImageElement>('img[data-leccion]')]
        .map(img => new URL(img.currentSrc || img.src, location.href))
        .filter(url => url.origin === location.origin)
        .map(url => url.href)
    )];
    function decir(texto: string, tipo = 'info') {
      estado.textContent = texto;
      iconos.forEach(icono => { icono.style.display = icono.dataset.icono === tipo ? '' : 'none'; icono.removeAttribute('hidden'); });
    }
    function guardada(cuantas: number) {
      boton.disabled = true;
      boton.textContent = 'Imágenes guardadas';
      decir(`Listo: ${cuantas} ${cuantas === 1 ? 'imagen guardada' : 'imágenes guardadas'} en este navegador. Los videos siguen necesitando internet.`, 'exito');
    }
    async function preparar() {
      if (!('caches' in window)) {
        decir('Este navegador no permite guardar imágenes. Puedes seguir leyendo la página.', 'error');
        return;
      }
      boton.setAttribute('aria-busy', 'true');
      try {
        const cache = await caches.open(CACHE);
        const urls = direcciones();
        if (urls.length === 0) {
          decir('No hay imágenes propias para guardar en esta página. Puedes seguir leyendo.');
          return;
        }
        const guardadas = await Promise.all(urls.map(url => cache.match(url, { ignoreVary: true })));
        if (guardadas.every(Boolean)) guardada(urls.length);
        else boton.disabled = false;
      } catch {
        decir('No se pudo acceder al almacenamiento. Comprueba el espacio disponible o los permisos de este navegador.', 'error');
        boton.textContent = 'Intentar de nuevo';
        boton.disabled = false;
      } finally {
        boton.removeAttribute('aria-busy');
      }
    }
    boton.addEventListener('click', async () => {
      if (ocupada) return;
      if (document.documentElement.dataset.conexion === 'no') {
        decir('No hay conexión. Cuando tengas señal, vuelve a tocar el botón.', 'error');
        return;
      }
      ocupada = true;
      boton.disabled = true;
      boton.setAttribute('aria-busy', 'true');
      boton.textContent = 'Guardando imágenes…';
      decir('Preparando la descarga…');
      try {
        const cache = await caches.open(CACHE);
        const hechas = await guardarImagenes(cache, direcciones(), (hechas, total) => decir(`Guardando ${hechas} de ${total} imágenes…`));
        guardada(hechas);
      } catch {
        boton.disabled = false;
        boton.textContent = 'Intentar de nuevo';
        decir('No se pudo terminar. Revisa la conexión y el espacio disponible. Puedes reintentar; se conservan las imágenes ya guardadas.', 'error');
      } finally {
        ocupada = false;
        boton.removeAttribute('aria-busy');
      }
    });
    void preparar();
  }
</script>
