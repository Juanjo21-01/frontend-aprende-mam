---
import ContenidoExterno from './ContenidoExterno.astro';
import FuenteCitada from './FuenteCitada.astro';
import type { Documento } from '@/data/contenido-esquema';
interface Props { documento: Documento }
const { documento } = Astro.props;
const base = import.meta.env.BASE_URL;
/** `820` → «820 KB»; `2300` → «2.2 MB». */
function tamano(kb: number): string {
  return kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${kb} KB`;
}

/** Las rutas del sitio llevan el prefijo; las https van tal cual. */
const destino = (url: string) => (url.startsWith('/') ? `${base.replace(/\/$/, '')}${url}` : url);

/**
 * Un PDF puede vivir en el sitio o en otro (Google Drive, por ejemplo). El atributo `download` solo
 * lo respeta el navegador con archivos del mismo origen, y el botón no puede prometer una
 * descarga que decide un tercero: con uno externo dice «Abrir» y avisa adónde sale.
 */
const externo = (url: string) => url.startsWith('https://');
const sitio = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
                <article class="rounded-2xl border border-borde bg-papel p-5">
                  <h3 class="text-xl">{documento.titulo}</h3>
                  {documento.descripcion && (
                    <p class="mt-1 text-tinta-suave">{documento.descripcion}</p>
                  )}

                  <a
                    href={destino(documento.archivo_url)}
                    download={externo(documento.archivo_url) ? undefined : ''}
                    rel={externo(documento.archivo_url) ? 'noopener noreferrer' : undefined}
                    class="mt-3 inline-flex min-h-12 items-center tocable gap-2 rounded-2xl bg-negro-campo px-4 py-2 font-bold text-negro-texto no-underline hover:bg-papel-hondo [--tocable-sombra:var(--color-negro)]"
                  >
                    {externo(documento.archivo_url) ? 'Abrir PDF' : 'Descargar PDF'}
                    {documento.tamano_kb !== null && ` (${tamano(documento.tamano_kb)})`}
                  </a>
                  {externo(documento.archivo_url) && (
                    <p class="mt-1 text-base text-tinta-suave">
                      Se abre en {sitio(documento.archivo_url)}. Necesita internet.
                    </p>
                  )}

                  {documento.licencia && (
                    <p class="mt-3 text-base text-tinta-suave">Licencia: {documento.licencia}</p>
                  )}
                  {documento.fuente && <FuenteCitada fuente={documento.fuente} class="mt-1" />}

                  {documento.video_url && (
                    <ContenidoExterno
                      url={documento.video_url}
                      titulo={`Video de apoyo: ${documento.titulo}`}
                    />
                  )}
                </article>
