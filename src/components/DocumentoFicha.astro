---
import BotonPdf from './BotonPdf.astro';
import ContenidoExterno from './ContenidoExterno.astro';
import FuenteCitada from './FuenteCitada.astro';
import type { Documento } from '@/data/contenido-esquema';
interface Props { documento: Documento }
const { documento } = Astro.props;
---
                <article class="rounded-2xl border border-borde bg-papel p-5">
                  <h3 class="text-xl">{documento.titulo}</h3>
                  {documento.descripcion && (
                    <p class="mt-1 text-tinta-suave">{documento.descripcion}</p>
                  )}

                  <BotonPdf url={documento.archivo_url} tamanoKb={documento.tamano_kb} />

                  {documento.licencia && (
                    <p class="mt-3 text-base text-tinta-suave">Licencia: {documento.licencia}</p>
                  )}
                  {documento.fuente && <FuenteCitada fuente={documento.fuente} class="mt-1" />}

                  {documento.video_url && (
                    <ContenidoExterno
                      url={documento.video_url}
                      titulo={`Video de apoyo: ${documento.titulo}`}
                    />
                  )}
                </article>
