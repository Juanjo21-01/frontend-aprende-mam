---
/**
 * La ficha de un tema: ícono en su cuadro de color, nombre y cuántas palabras tiene.
 *
 * Toda la tarjeta es el enlace, no solo el nombre: un objetivo de 72 px de alto se acierta a la
 * primera con el pulgar; un enlace de una línea de texto, no.
 *
 * Por debajo de 420 px (casi todos los teléfonos de gama baja miden 360) el ícono va encima del
 * nombre y no al lado: así caben dos fichas por fila sin partir «La naturaleza» en dos líneas.
 *
 * Desde el rediseño la tarjeta es papel con borde y el color va solo en el cuadro del ícono. Los
 * temas se reparten en tres colores (ver `temas.ts`), así que lo que distingue a uno de otro es
 * el ícono; teñir la tarjeta entera haría que siete fichas en tres colores se leyeran como tres
 * botones repetidos. Es `tocable`: tiene la sombra de botón y se hunde al pulsarla.
 *
 * Un tema que el backend agregue y que todavía no tenga color se ve gris, nunca roto.
 */
import IconoTema from '@/components/IconoTema.astro';
import { temaVisual } from '@/data/temas';
import type { Categoria } from '@/data/vocabulario';

interface Props {
  categoria: Categoria;
  cantidad: number;
}

const { categoria, cantidad } = Astro.props;

const base = import.meta.env.BASE_URL;
const visual = temaVisual(categoria.slug);
---

<a
  href={`${base}diccionario/tema/${categoria.slug}`}
  class="tocable flex h-full min-h-18 flex-col items-start gap-2 rounded-2xl border-2 border-borde bg-papel p-3 no-underline min-[420px]:flex-row min-[420px]:items-center min-[420px]:gap-3"
>
  <span class:list={['grid size-12 shrink-0 place-items-center rounded-xl', visual.chip]}>
    <IconoTema slug={categoria.slug} tamano={28} />
  </span>

  <span class="min-w-0">
    <span class="block leading-tight font-bold text-tinta">{categoria.nombre_es}</span>
    {
      categoria.nombre_mam && (
        <span lang="mam" class="mam block text-base text-tinta-suave">
          {categoria.nombre_mam}
        </span>
      )
    }
    <span class="block text-base text-tinta-suave">
      {cantidad === 0 ? 'Sin palabras todavía' : `${cantidad} palabra${cantidad === 1 ? '' : 's'}`}
    </span>
  </span>
</a>
