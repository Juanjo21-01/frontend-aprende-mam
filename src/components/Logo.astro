---
/*
 * El logotipo: volcán y libro, con el nombre escrito al lado.
 *
 * Sale del logo ilustrado anterior (`marca/logo.png`), reducido a lo que se lee a 16 px: el
 * volcán de San Marcos con su nieve, el sol detrás y un libro abierto en abanico sobre una tapa
 * roja. El libro va sin contorno a propósito: el volumen lo hacen las dos capas de hojas, y el
 * contorno grueso de las pruebas anteriores lo hacía parecer una canasta. Se eligió el 29 de
 * octubre de 2026 entre cinco marcas y tres libros (`.impeccable/mocks/decision/logos.html` y
 * `logo-libros.html`).
 *
 * Es SVG en línea y no imagen: menos de 1 KB, sin otra petición en 3G, nítido a cualquier
 * tamaño. Los colores salen de los tokens de global.css por `var()`, así que si la paleta
 * cambia, el logo cambia con ella. Va en los plenos y no en los campos claros: a 16 px los
 * tonos claros no se distinguen entre sí.
 *
 * La marca es decorativa (`aria-hidden`): el nombre va escrito al lado, y un texto alternativo
 * haría que un lector de pantalla anunciara «AprendeMam AprendeMam».
 *
 * El nombre no lleva `lang="mam"`: «AprendeMam» es el nombre propio del sitio, en castellano.
 */
interface Props {
  /** Lado de la marca en píxeles. El nombre escala con ella. */
  tamano?: number;
  /** Solo la marca, sin el nombre (para espacios estrechos). */
  soloMarca?: boolean;
  /**
   * Esconde el nombre solo en tableta (768–1023 px), donde el encabezado tiene que dejar sitio a
   * las seis secciones en una fila. Lo esconde a la vista, no al lector de pantalla.
   */
  compactoEnTableta?: boolean;
  class?: string;
}

const { tamano = 32, soloMarca = false, compactoEnTableta = false, class: clase } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', clase]}>
  <svg viewBox="0 0 64 64" width={tamano} height={tamano} aria-hidden="true" class="shrink-0">
    <circle cx="42" cy="18" r="9" fill="var(--color-amarillo)"></circle>
    <path d="M8 44 26 13 32 21 37 15 56 44Z" fill="var(--color-verde)"></path>
    <path d="M26 13 32 21 29.5 24 26 19.5 22.5 24Z" fill="var(--color-papel)"></path>
    <path d="M2 46Q17 41 32 47 47 41 62 46V58Q47 54 32 60 17 54 2 58Z" fill="var(--color-rojo)"
    ></path>
    <path d="M5 43.5Q18 39.5 31.2 45V57Q18 52 5 55.5Z" fill="var(--color-negro-campo)"></path>
    <path d="M59 43.5Q46 39.5 32.8 45V57Q46 52 59 55.5Z" fill="var(--color-negro-campo)"></path>
    <path d="M7 41.5Q19 37.5 31.2 43V55.5Q19 50.5 7 53.5Z" fill="var(--color-papel)"></path>
    <path d="M57 41.5Q45 37.5 32.8 43V55.5Q45 50.5 57 53.5Z" fill="var(--color-papel)"></path>
  </svg>
  {
    !soloMarca && (
      <span
        class:list={[
          'font-bold leading-none text-tinta',
          compactoEnTableta && 'md:max-lg:sr-only',
        ]}
        style={`font-size: ${Math.round(tamano * 0.7)}px`}
      >
        Aprende<span class="text-verde">Mam</span>
      </span>
    )
  }
</span>
