---
// Navegación principal. Sin JavaScript: en pantallas angostas los enlaces simplemente
// se acomodan en varias filas. Un menú hamburguesa exigiría hidratar una isla para algo
// que el ajuste de línea resuelve gratis.
// Las cinco áreas de contenido para estudiantes y docentes. «Base legal» queda en el pie:
// es material de respaldo institucional, no algo que una estudiante busque a diario.
const enlaces = [
  { href: '/diccionario', texto: 'Diccionario' },
  { href: '/gramatica', texto: 'Gramática' },
  { href: '/cultura', texto: 'Cultura' },
  { href: '/materiales', texto: 'Materiales' },
  { href: '/juegos', texto: 'Juegos' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const actual = Astro.url.pathname.replace(/\/$/, '');
---

<nav aria-label="Secciones del sitio">
  <ul class="flex flex-wrap gap-x-5 gap-y-1">
    {
      enlaces.map(({ href, texto }) => {
        const ruta = `${base}${href}`;
        const activo = actual === ruta || actual.startsWith(`${ruta}/`);
        return (
          <li>
            <a
              href={ruta}
              aria-current={activo ? 'page' : undefined}
              class:list={[
                'inline-block py-1 underline-offset-4 hover:underline',
                activo
                  ? 'font-bold text-jade-hondo underline'
                  : 'text-tinta-suave',
              ]}
            >
              {texto}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
