---
import { ESTILO_RUMBO, NAV_SUPERIOR, esActiva, href } from '@/data/secciones';

/*
 * Navegación superior, de tableta para arriba. En el teléfono la reemplaza la barra inferior
 * (`NavInferior.astro`): nunca se ven las dos a la vez.
 *
 * La sección en la que estamos lleva el campo claro de su rumbo —rojo en Juegos, amarillo en
 * Cultura— además de negrita y `aria-current`. Así el color de la sección se aprende desde la
 * navegación, y el activo no depende solo del color: el fondo cambia de forma, no solo de tono.
 *
 * Sin JavaScript. A 768 px caben las seis secciones en una fila; si un nombre largo llegara a
 * no caber, `flex-wrap` las acomoda en dos en vez de esconder ninguna.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const actual = Astro.url.pathname;
---

<nav aria-label="Secciones del sitio" class="hidden md:block">
  <ul class="flex flex-wrap justify-end gap-1">
    {
      NAV_SUPERIOR.map((seccion) => {
        const activa = esActiva(seccion, actual, base);
        return (
          <li>
            <a
              href={href(seccion, base)}
              aria-current={activa ? 'page' : undefined}
              class:list={[
                'flex min-h-11 items-center rounded-xl px-3 text-base no-underline lg:px-3.5',
                activa
                  ? [ESTILO_RUMBO[seccion.rumbo].activo, 'font-bold']
                  : 'text-tinta-suave hover:bg-papel-hondo hover:text-tinta',
              ]}
            >
              {seccion.nombre}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
