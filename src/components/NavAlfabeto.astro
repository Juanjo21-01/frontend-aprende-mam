---
/**
 * El alfabeto Mam completo como navegación.
 *
 * Se muestran los 32 grafemas aunque muchos no tengan entradas todavía. Un alfabeto con
 * huecos es información —«el Mam tiene `ky’` y aquí aún no hay nada con esa letra»— y además
 * es una de las cosas que el sitio enseña: que el alfabeto no es el del castellano, que `ch`
 * va antes que `ch’` y que el saltillo lo cierra.
 *
 * Las letras sin entradas van como texto y no como enlace muerto. Sin JavaScript, un enlace
 * que lleva a una página vacía es peor que un rótulo apagado.
 */
import type { GrupoAlfabetico } from '@/data/vocabulario';

interface Props {
  grupos: GrupoAlfabetico[];
  /** Grafema en el que estamos, si la página es la de una letra. */
  actual?: string;
}

const { grupos, actual } = Astro.props;

const base = import.meta.env.BASE_URL;
---

<nav aria-label="Alfabeto Mam">
  <ul class="flex flex-wrap gap-1">
    {
      grupos.map(({ grafema, slug, entradas }) => {
        const vacia = entradas.length === 0;
        const esActual = grafema === actual;

        /*
         * Las letras sin entradas iban al 45 % de opacidad. En un teléfono barato y a plena
         * luz eso deja de leerse: el usuario no ve una letra apagada, ve un borrón. Ahora se
         * distinguen por el borde punteado —que dice «vacío» sin quitar contraste— y el texto
         * se queda en `tinta-suave`, que sí se lee.
         */
        if (vacia) {
          return (
            <li>
              <span
                lang="mam"
                class="mam inline-flex h-11 min-w-11 items-center justify-center rounded-lg border border-dashed border-borde px-2 text-tinta-suave"
                title="Todavía sin entradas"
              >
                {grafema}
              </span>
            </li>
          );
        }

        return (
          <li>
            <a
              href={`${base}diccionario/letra/${slug}`}
              lang="mam"
              aria-current={esActual ? 'page' : undefined}
              class:list={[
                'mam inline-flex h-11 min-w-11 items-center justify-center rounded-lg border px-2 no-underline',
                esActual
                  ? 'border-oro-hondo bg-oro font-bold text-tinta'
                  : 'border-jade/35 text-jade-hondo hover:border-jade hover:bg-papel-hondo',
              ]}
            >
              {grafema}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
