---
/**
 * Una página de contenido editorial completa: título, cuerpo, video, fuente y descarga.
 *
 * La usan las tres secciones que escribe el docente —cultura, gramática y base legal— para no
 * repetir el armado tres veces: el video tiene que ser siempre el mismo componente
 * (`ContenidoExterno`) y la fuente siempre al pie, y eso se garantiza teniéndolo en un solo sitio.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import { CULTURA, GRAMATICA, BASE_LEGAL } from '@/data/secciones';
import ContenidoExterno from '@/components/ContenidoExterno.astro';
import DescargarLeccion from '@/components/DescargarLeccion.astro';
import FuenteCitada from '@/components/FuenteCitada.astro';
import Prosa from '@/components/Prosa.astro';
import type { Pagina } from '@/data/contenido-esquema';
import { imagenesDe } from '@/data/markdown';

interface Props {
  pagina: Pagina;
  /** De qué sección cuelga, para el enlace de regreso. */
  volver: { href: string; texto: string };
}

const { pagina, volver } = Astro.props;
const seccion = volver.href.replace(/\/$/, '') === 'cultura' ? CULTURA : volver.href.replace(/\/$/, '') === 'gramatica' ? GRAMATICA : BASE_LEGAL;

const base = import.meta.env.BASE_URL;
const propias = imagenesDe(pagina.cuerpo).filter((src) => src.startsWith('/')).length;
// Primera línea del cuerpo, sin marcas, para el `<meta name="description">`.
const resumen =
  pagina.cuerpo
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#*>`_-]/g, '')
    .split('\n')
    .map((linea) => linea.trim())
    .find(Boolean)
    ?.slice(0, 155) ?? pagina.titulo;
---

<BaseLayout titulo={pagina.titulo} descripcion={resumen}>
  <CabeceraSeccion seccion={seccion} titulo={pagina.titulo} volver={{ href: `${base}${volver.href}`, texto: volver.texto }} />

  <article class="mt-8">
    <Prosa cuerpo={pagina.cuerpo} />
  </article>


  {pagina.video_url && <ContenidoExterno url={pagina.video_url} titulo={pagina.titulo} />}

  <DescargarLeccion cantidad={propias} />

  {pagina.fuente && <FuenteCitada fuente={pagina.fuente} class="mt-8" />}
</BaseLayout>
