---
/**
 * Las fuentes citadas en la página, numeradas una sola vez.
 *
 * La trazabilidad es un requisito académico del proyecto: ninguna palabra aparece sin decir de
 * dónde salió. Pero repetir «Diccionario Mam, Comunidad Lingüística Mam (COLIMAM), ALMG, 2011»
 * bajo cada entrada costaría unos ochenta bytes por entrada, que en el corpus completo son
 * casi medio megabyte de HTML para decir doce veces lo mismo.
 */
import type { Fuente } from '../data/vocabulario';

interface Props {
  fuentes: Fuente[];
}

const { fuentes } = Astro.props;
---

{
  fuentes.length > 0 && (
    <section id="fuentes" class="mt-10 border-t border-borde pt-5 text-sm text-tinta-suave">
      <h2 class="text-base font-bold">Fuentes</h2>
      <ol class="mt-3 space-y-1">
        {fuentes.map((fuente, indice) => (
          <li class="flex gap-2">
            <span aria-hidden="true">{indice + 1}.</span>
            <span>
              <cite class="not-italic">{fuente.titulo}</cite>
              {fuente.institucion && <>. {fuente.institucion}</>}
              {fuente.anio !== null && <>, {fuente.anio}</>}.
            </span>
          </li>
        ))}
      </ol>
    </section>
  )
}
