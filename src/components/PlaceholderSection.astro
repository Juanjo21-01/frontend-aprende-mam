---
// Sección todavía sin contenido. Dice qué va a haber aquí y en qué estado está, en vez
// de fingir que la página existe. El usuario tiene que poder distinguir «esto aún no está
// hecho» de «esto se rompió» — la misma razón por la que los iframes externos caídos se
// sustituyen por un aviso y no por un marco vacío.
import CabeceraSeccion from './CabeceraSeccion.astro';
import type { Seccion } from '@/data/secciones';
interface Props {
  seccion?: Seccion;
  titulo: string;
  resumen: string;
  pendiente: string[];
}

const { titulo, resumen, pendiente, seccion } = Astro.props;
---

{seccion ? <CabeceraSeccion seccion={seccion} titulo={titulo}><p>{resumen}</p></CabeceraSeccion> : <><h1 class="text-3xl">{titulo}</h1><p class="mt-4 text-lg text-tinta-suave">{resumen}</p></>}

<div class="mt-8 max-w-3xl rounded-2xl bg-papel-hondo p-5">
  <p class="font-bold text-tinta">Esta sección todavía no tiene contenido.</p>
  <p class="mt-2 text-tinta-suave">Lo que va a incluir:</p>
  <ul class="mt-3 list-disc space-y-1 pl-5 text-tinta-suave">
    {pendiente.map((punto) => <li>{punto}</li>)}
  </ul>
</div>

<nav class="mt-6 flex flex-wrap gap-3" aria-label="Mientras se publica el contenido">
  <a href={`${import.meta.env.BASE_URL}diccionario`} class="tocable inline-flex min-h-12 items-center rounded-2xl bg-verde-campo px-4 py-2 font-bold text-verde-texto no-underline [--tocable-sombra:var(--color-verde)]">Explorar el diccionario</a>
  <a href={`${import.meta.env.BASE_URL}juegos`} class="inline-flex min-h-12 items-center px-2 underline">Practicar con juegos</a>
</nav>
