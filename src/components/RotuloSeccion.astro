---
/**
 * Encabezado de un bloque dentro de una página.
 *
 * Desde el rediseño es un título llano, sin el rombo dorado ni el filete de la dirección
 * anterior: la jerarquía la hacen el tamaño y el espacio de arriba, y el color se reserva para
 * lo que se toca. Se conserva como componente para que todas las páginas compartan tamaño y
 * nivel, y para no tocar cada página que lo usa.
 */
interface Props {
  titulo: string;
  /** Nivel del encabezado. `h2` salvo que la sección cuelgue de otra. */
  nivel?: 'h2' | 'h3';
  class?: string;
}

const { titulo, nivel = 'h2', class: clase } = Astro.props;

const Encabezado = nivel;
---

<Encabezado class:list={[nivel === 'h2' ? 'text-2xl' : 'text-xl', clase]}>{titulo}</Encabezado>
