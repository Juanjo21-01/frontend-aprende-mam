---
import IconoSeccion from './IconoSeccion.astro';
import Logo from './Logo.astro';
import { ESTILO_RUMBO, TODAS, href } from '@/data/secciones';

/*
 * El pie: todas las secciones y los créditos.
 *
 * «Todas las secciones» (`#secciones`) es el destino del botón «Más» de la barra inferior del
 * teléfono, que solo trae tres. Por eso lista las seis con su color de rumbo y su ícono, como
 * tarjetas tocables y no como enlaces de texto pequeño. En escritorio sobra un poco, pero sirve
 * de mapa del sitio al final de una página larga.
 *
 * Papel hondo, no verde: con la tonalidad «B2 · Claro» el armazón es claro y el color se
 * reserva para lo que se toca.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const anio = new Date().getFullYear();
---

<footer class="border-t border-borde bg-papel-hondo">
  <div class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <section id="secciones" aria-labelledby="secciones-titulo" class="scroll-mt-4">
      <h2 id="secciones-titulo" class="text-xl">Todas las secciones</h2>
      <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
        {
          TODAS.map((seccion) => {
            const estilo = ESTILO_RUMBO[seccion.rumbo];
            return (
              <li>
                <a
                  href={href(seccion, base)}
                  class:list={[
                    'tocable flex h-full min-h-14 items-center gap-2.5 rounded-2xl px-3.5 py-3 font-bold no-underline',
                    estilo.campo,
                    estilo.sombra,
                  ]}
                >
                  <IconoSeccion d={seccion.icono} tamano={22} />
                  {seccion.nombre}
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <div class="mt-10 flex flex-col gap-3 border-t border-borde pt-6 text-base text-tinta-suave">
      <Logo tamano={28} />
      <p class="max-w-[68ch]">
        Contenido tomado de materiales de MINEDUC, DIGEBI y la Academia de Lenguas Mayas de
        Guatemala (ALMG). Cada entrada conserva su fuente bibliográfica.
      </p>
      <p class="max-w-[68ch]">
        Tipografía <a href="https://software.sil.org/charis/" class="text-tinta underline"
          >Charis SIL</a
        >, de SIL International, bajo licencia OFL. Se distribuye una versión recortada; la
        licencia acompaña a los archivos en <code>/fonts/OFL.txt</code>.
      </p>
      <p>© {anio} AprendeMam</p>
    </div>
  </div>
</footer>
