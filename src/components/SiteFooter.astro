---
/*
 * El pie cierra la página con la misma banda verde con que la abre el encabezado, y con su
 * cenefa arriba. Los enlaces van subrayados y en papel: sobre el verde, el dorado no llega a
 * 4.5:1 y este es texto pequeño.
 */
interface Props {
  ancho?: 'lectura' | 'panel';
}

const { ancho = 'lectura' } = Astro.props;

const base = import.meta.env.BASE_URL;
const anio = new Date().getFullYear();
const contenedor = ancho === 'panel' ? 'max-w-5xl' : 'max-w-3xl';
---

<div class="cenefa"></div>

<footer class="bg-jade-hondo">
  <div
    class:list={[
      'mx-auto flex flex-col gap-3 px-5 py-6 text-sm text-jade-claro',
      contenedor,
    ]}
  >
    <p>
      Contenido tomado de materiales de MINEDUC, DIGEBI y la Academia de Lenguas Mayas de
      Guatemala (ALMG). Cada entrada conserva su fuente bibliográfica.
    </p>
    <p>
      Tipografía <a
        href="https://software.sil.org/charis/"
        class="text-papel underline underline-offset-2">Charis SIL</a
      >, de SIL International, bajo licencia OFL. Se distribuye una versión recortada; la
      licencia acompaña a los archivos en <code>/fonts/OFL.txt</code>.
    </p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <span>© {anio} AprendeMam</span>
      <a href={`${base}base-legal`} class="text-papel underline underline-offset-2">Base legal</a>
      <a href={`${base}prueba-tipografica`} class="text-papel underline underline-offset-2">
        Prueba tipográfica
      </a>
    </p>
  </div>
</footer>
