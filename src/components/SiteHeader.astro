---
import Logo from './Logo.astro';
import MainNav from './MainNav.astro';

/*
 * Encabezado claro: el logotipo a la izquierda y, de tableta para arriba, la navegación a la
 * derecha. En el teléfono solo va el logotipo; las secciones están en la barra inferior.
 *
 * Fondo papel con una línea de borde, no una banda de color: con la tonalidad «B2 · Claro» el
 * color fuerte se reserva para lo que se toca, y un encabezado lleno de verde le quitaría peso
 * a los rumbos de la portada.
 *
 * El ancho es el del armazón (`max-w-6xl`) en todas las páginas, también en las de lectura: el
 * encabezado y el pie son el marco, y la columna de texto se centra dentro.
 */
const base = import.meta.env.BASE_URL;
---

<header class="border-b border-borde bg-papel">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-6 px-4 md:px-6">
    <a href={base} class="flex min-h-11 items-center no-underline">
      <Logo tamano={36} compactoEnTableta />
    </a>

    <MainNav />
  </div>
</header>
