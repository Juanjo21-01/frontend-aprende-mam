---
/**
 * Página no encontrada.
 *
 * Astro la emite como `dist/404.html` y Netlify la sirve sola, con el código 404, a cualquier
 * dirección que no exista. Sin ella, quien escribe mal una dirección o abre un enlace viejo
 * compartido por WhatsApp ve la página genérica de Netlify: en inglés, sin la marca del sitio
 * y sin forma de volver, que es justo lo que se lee como «el sitio se rompió».
 *
 * No es la página de respaldo sin conexión (`/sin-conexion`): esta responde cuando sí hay
 * internet y la dirección no existe. Sin señal, el service worker no llega a pedirla.
 *
 * El caso más probable para este público es una palabra del diccionario escrita a mano en la
 * barra de direcciones. Por eso lo primero que ofrece es buscarla.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const salidas = [
  { href: '', titulo: 'Inicio', texto: 'La portada, con todos los temas' },
  { href: 'juegos', titulo: 'Juegos', texto: 'Practica las palabras de cada tema' },
  { href: 'gramatica', titulo: 'Gramática', texto: 'Las 32 letras del alfabeto Mam' },
];
---

<BaseLayout
  titulo="Página no encontrada"
  descripcion="La dirección que buscas no existe en AprendeMam."
>
  <h1 class="text-3xl">No encontramos esta página</h1>

  <p class="mt-4 text-lg text-tinta-suave">
    Puede que la dirección esté mal escrita o que la página haya cambiado de lugar.
  </p>

  <div class="mt-8 overflow-hidden rounded-xl border-2 border-jade-hondo">
    <a
      href={`${base}diccionario`}
      class="flex min-h-14 items-center gap-3 bg-papel px-4 py-3 text-lg no-underline"
    >
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        class="shrink-0 text-jade-hondo"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M16.5 16.5 21 21"></path>
      </svg>
      <span class="font-bold text-jade-hondo">Buscar la palabra en el diccionario</span>
    </a>
    <div class="h-1 bg-oro" aria-hidden="true"></div>
  </div>

  <ul class="mt-6 grid gap-3 sm:grid-cols-3">
    {
      salidas.map(({ href, titulo, texto }) => (
        <li>
          <a
            href={`${base}${href}`}
            class="flex h-full min-h-17 flex-col justify-center rounded-xl border border-borde p-4 no-underline hover:border-jade"
          >
            <span class="block font-bold text-jade-hondo">{titulo}</span>
            <span class="block text-sm text-tinta-suave">{texto}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
