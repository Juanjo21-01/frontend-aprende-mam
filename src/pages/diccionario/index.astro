---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NavAlfabeto from '@/components/NavAlfabeto.astro';
import FichaTema from '@/components/FichaTema.astro';
import RotuloSeccion from '@/components/RotuloSeccion.astro';
import BuscadorDiccionario from '@/components/BuscadorDiccionario.tsx';
import { rutaDeDatos } from '@/data/busqueda';
import { cargarVocabulario, porLetra, porTema } from '@/data/vocabulario';

const vocabulario = await cargarVocabulario();
const grupos = porLetra(vocabulario.entradas);
const temas = porTema(vocabulario);

const base = import.meta.env.BASE_URL;

const total = vocabulario.entradas.length;
const conLetra = grupos.filter((grupo) => grupo.entradas.length > 0).length;

const actualizado = new Intl.DateTimeFormat('es-GT', { dateStyle: 'long' }).format(
  new Date(vocabulario.generado_en)
);
---

<BaseLayout
  titulo="Diccionario"
  descripcion="Diccionario Mam–castellano de la variante de San Marcos, con su fuente bibliográfica. Funciona sin conexión."
  ancho="panel"
>
  <h1 class="text-3xl">Diccionario</h1>

  <p class="mt-3 max-w-2xl text-lg text-tinta-suave">
    Vocabulario <span lang="mam">Mam</span>–castellano de la variante de San Marcos. Cada
    palabra conserva la obra de la que se tomó.
  </p>

  {
    total === 0 ? (
      <div class="mt-8 rounded-xl border border-borde bg-papel-hondo p-5">
        <p class="font-bold">Todavía no hay palabras publicadas.</p>
        <p class="mt-2 text-tinta-suave">
          No es un fallo del sitio. Solo se publica lo que el validador lingüístico ya revisó, y
          el primer lote está en revisión. En cuanto se apruebe aparecerá aquí.
        </p>
      </div>
    ) : (
      <p class="mt-2 text-tinta-suave">
        {total} palabras en {conLetra} de las 32 letras del alfabeto.
      </p>
    )
  }

  {
    /*
     * La isla solo se monta si hay algo que buscar: con el diccionario vacío sería mandar
     * React al teléfono para filtrar cero palabras. Mientras el validador no apruebe el
     * primer lote, esta página sigue saliendo sin una sola etiqueta `<script>`.
     *
     * `client:visible` y no `client:load`: la caja está arriba del todo, así que en la
     * práctica hidrata enseguida, pero quien llegue por un enlace directo a un tema no paga
     * el JavaScript de una caja que nunca aparece en pantalla.
     */
    total > 0 && (
      <div class="mt-8 max-w-xl">
        <BuscadorDiccionario
          client:visible
          ruta={rutaDeDatos(vocabulario.version)}
          total={total}
          base={base}
        />
      </div>
    )
  }

  <RotuloSeccion titulo="Por tema" class="mt-10" />

  <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {
      temas.map(({ categoria, entradas }) => (
        <li>
          <FichaTema categoria={categoria} cantidad={entradas.length} />
        </li>
      ))
    }
  </ul>

  <RotuloSeccion titulo="Por letra" class="mt-10" />

  <p class="mt-3 max-w-2xl text-tinta-suave">
    El alfabeto <span lang="mam">Mam</span> tiene 32 grafemas y no sigue el orden del
    castellano: <span lang="mam" class="mam">ch</span> va antes que{' '}
    <span lang="mam" class="mam">ch’</span>, <span lang="mam" class="mam">x</span> antes que{' '}
    <span lang="mam" class="mam">ẍ</span>, y el saltillo lo cierra. Las letras apagadas
    todavía no tienen palabras.
  </p>

  <div class="mt-4">
    <NavAlfabeto grupos={grupos} />
  </div>

  <section class="mt-10 rounded-xl border border-borde bg-papel-hondo p-5">
    <h2 class="text-xl">Sin internet</h2>
    <p class="mt-3 text-tinta-suave">
      Después de la primera visita, el diccionario completo y su búsqueda quedan guardados en
      el teléfono y funcionan sin señal.
    </p>
    <p class="mt-3 text-sm text-tinta-suave">
      Vocabulario versión {vocabulario.version}, actualizado el {actualizado}.
    </p>
  </section>
</BaseLayout>
