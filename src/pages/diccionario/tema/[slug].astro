---
/**
 * Las palabras de un tema.
 *
 * A diferencia de las páginas por letra, aquí sí se genera la ruta aunque el tema esté vacío:
 * los temas son la unidad con la que trabaja el aula —«la lección de los colores»— y el enlace
 * puede estar ya repartido en una guía impresa. Un tema sin palabras dice que todavía no hay
 * nada revisado; un 404 diría que el sitio se rompió.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import EntradaFicha from '@/components/EntradaFicha.astro';
import IconoTema from '@/components/IconoTema.astro';
import PieDeFuentes from '@/components/PieDeFuentes.astro';
import { JUEGOS, MINIMO_POR_TEMA, aPalabraDeJuego, aptaPara } from '@/data/juegos';
import { temaVisual } from '@/data/temas';
import {
  cargarVocabulario,
  fuentesCitadas,
  indiceDeFuente,
  porTema,
  type Categoria,
  type Entrada,
} from '@/data/vocabulario';

export async function getStaticPaths() {
  const vocabulario = await cargarVocabulario();

  return porTema(vocabulario).map(({ categoria, entradas }) => ({
    params: { slug: categoria.slug },
    props: { categoria, entradas, categorias: vocabulario.categorias },
  }));
}

interface Props {
  categoria: Categoria;
  entradas: Entrada[];
  categorias: Categoria[];
}

const { categoria, entradas, categorias } = Astro.props;

const base = import.meta.env.BASE_URL;

const nombresDeTema = new Map(categorias.map((otra) => [otra.slug, otra.nombre_es]));
const fuentes = fuentesCitadas(entradas);

const cuantas = entradas.length;

/*
 * El color del tema va en el encabezado y no en cada entrada. Aquí todas las palabras son de
 * este tema, así que repetir la etiqueta en las doce fichas sería decir doce veces lo mismo;
 * arriba, en cambio, dice de un vistazo en qué lección estás. Las fichas solo llevan etiqueta
 * cuando la palabra pertenece además a otro tema.
 */
const visual = temaVisual(categoria.slug);

// Mismo criterio que las rutas de `/juegos` (`temasJugables`): un juego se enlaza solo si el
// tema llega al mínimo de palabras aptas para ese juego; si no, no hay partida a la que ir.
const palabras = entradas.map(aPalabraDeJuego);
const juegosListos = JUEGOS.filter(
  (juego) =>
    juego.listo &&
    palabras.filter((palabra) => aptaPara(juego.slug, palabra)).length >= MINIMO_POR_TEMA
);
const jugable = juegosListos.length > 0;
---

<BaseLayout
  titulo={categoria.nombre_es}
  descripcion={`Palabras de ${categoria.nombre_es.toLocaleLowerCase('es')} en Mam, variante de San Marcos, con su fuente bibliográfica.`}
>
  <a
    href={`${base}diccionario`}
    class="mb-3 inline-flex min-h-11 items-center gap-1 text-base text-tinta-suave underline"
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m15 5-7 7 7 7"></path>
    </svg>
    Diccionario
  </a>

  <div class:list={['flex items-center gap-4 rounded-2xl border-2 p-4', visual.ficha]}>
    <span class="grid size-16 shrink-0 place-items-center rounded-xl bg-papel">
      <IconoTema slug={categoria.slug} tamano={40} class={visual.texto} />
    </span>
    <div>
      <h1 class="text-3xl leading-tight md:text-4xl">{categoria.nombre_es}</h1>
      {
        categoria.nombre_mam && (
          <p class="mt-1 text-lg">
            <span lang="mam" class="mam">
              {categoria.nombre_mam}
            </span>
          </p>
        )
      }
    </div>
  </div>

  {
    cuantas === 0 ? (
      <div class="mt-8 rounded-2xl bg-papel-hondo p-5">
        <p class="font-bold">Este tema todavía no tiene palabras.</p>
        <p class="mt-2 text-tinta-suave">
          Las palabras se publican cuando un especialista en el idioma las revisa. En cuanto
          estén listas, aparecerán aquí.
        </p>
      </div>
    ) : (
      <p class="mt-3 text-tinta-suave">
        {cuantas} palabra{cuantas === 1 ? '' : 's'}, en el orden del alfabeto{' '}
        <span lang="mam">Mam</span>.
      </p>
    )
  }

  <dl class="mt-6 grid gap-3 md:grid-cols-2">
    {
      entradas.map((entrada) => (
        <EntradaFicha
          entrada={entrada}
          marca={indiceDeFuente(entrada, fuentes)}
          nombresDeTema={nombresDeTema}
          temaActual={categoria.slug}
          variante="tarjeta"
        />
      ))
    }
  </dl>

  {
    jugable && (
      // En el rojo de Juegos: es una puerta a esa sección, y así lo dice antes de leerlo.
      <section class="mt-10 rounded-2xl bg-rojo-tinte p-5">
        <h2 class="text-xl">Practicar este tema</h2>
        <ul class="mt-4 flex flex-wrap gap-3">
          {juegosListos.map((juego) => (
            <li>
              <a
                href={`${base}juegos/${juego.slug}/${categoria.slug}`}
                class="tocable inline-flex min-h-12 items-center rounded-2xl bg-rojo-campo px-4 font-bold text-rojo-texto no-underline [--tocable-sombra:var(--color-rojo)]"
              >
                {juego.nombre}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <PieDeFuentes fuentes={fuentes} />

  <p class="mt-10 text-base text-tinta-suave">
    <a href={`${base}diccionario`} class="underline">
      Ver todos los temas y el alfabeto completo
    </a>
  </p>
</BaseLayout>
