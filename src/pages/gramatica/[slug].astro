---
import PaginaEditorial from '@/components/PaginaEditorial.astro';
import { cargarContenido, paginasDe } from '@/data/contenido';

export async function getStaticPaths() {
  const paginas = paginasDe(await cargarContenido(), 'gramatica');
  return paginas.map((pagina) => ({ params: { slug: pagina.slug }, props: { pagina } }));
}

const { pagina } = Astro.props;
---

<PaginaEditorial pagina={pagina} volver={{ href: 'gramatica', texto: 'Gramática' }} />
