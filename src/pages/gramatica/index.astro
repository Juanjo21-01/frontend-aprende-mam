---
/**
 * Gramática. Por ahora, el alfabeto: las 32 letras, cómo se agrupan y la regla del apóstrofo.
 *
 * Todo sale de datos que el sitio ya tiene, sin texto inventado a mano:
 *
 *  - Las letras y su orden, de `alfabeto.ts` (copia del catálogo `grafemas` del backend).
 *  - Los grupos —vocales, letras de dos caracteres, glotalizadas, saltillo— se deducen de la
 *    forma de cada grafema, no de una lista escrita aparte que pudiera discrepar.
 *  - Cada ejemplo es una palabra real del diccionario, partida en letras con `grafemasDe()`,
 *    igual que en la sopa de letras. Con el corpus completo los ejemplos mejoran solos.
 *
 * Todo lo demás —pronombres, estructura de la oración, lo que el docente quiera explicar— lo
 * escribe él en el panel como páginas de la sección `gramatica` (`/gramatica/<slug>`), que se
 * listan debajo del alfabeto. Sin ninguna, la página es solo el alfabeto, y no anuncia nada:
 * un «próximamente» sin nadie que lo vaya a escribir sería prometer de más.
 *
 * HTML estático, sin JavaScript.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListaDePaginas from '@/components/ListaDePaginas.astro';
import RotuloSeccion from '@/components/RotuloSeccion.astro';
import { GRAFEMAS } from '@/data/alfabeto';
import { cargarContenido, paginasDe } from '@/data/contenido';
import { grafemasDe } from '@/data/juegos';
import { cargarVocabulario, porLetra, type Entrada } from '@/data/vocabulario';

const vocabulario = await cargarVocabulario();
const grupos = porLetra(vocabulario.entradas);
const lecciones = paginasDe(await cargarContenido(), 'gramatica');

const base = import.meta.env.BASE_URL;

/** Las letras de cada entrada, calculadas una vez. Una clave rota no tumba la página. */
const letrasDe = new Map<Entrada, string[]>();
for (const entrada of vocabulario.entradas) {
  try {
    letrasDe.set(
      entrada,
      grafemasDe(entrada).map((letra) => letra.toLocaleLowerCase('es'))
    );
  } catch {
    // `vocabulario.ts` ya valida el contrato; si una entrada no se deja partir, se queda sin
    // ser ejemplo y ya.
  }
}

/**
 * Un ejemplo por letra: la primera palabra que empieza con ella; si no hay, la primera que la
 * contiene. El saltillo nunca empieza una palabra, así que siempre cae en el segundo caso.
 */
function ejemplo(grafema: string): Entrada | undefined {
  const empieza = grupos.find((grupo) => grupo.grafema === grafema)?.entradas[0];
  if (empieza) return empieza;

  return vocabulario.entradas.find((entrada) => letrasDe.get(entrada)?.includes(grafema));
}

const VOCALES = new Set(['a', 'e', 'i', 'o', 'u']);
const SALTILLO = '’';

const vocales = GRAFEMAS.filter((g) => VOCALES.has(g));
const glotalizadas = GRAFEMAS.filter((g) => g !== SALTILLO && g.endsWith(SALTILLO));
const dobles = GRAFEMAS.filter((g) => g.length === 2 && !g.endsWith(SALTILLO));

const letras = grupos.map(({ grafema, slug, entradas }) => ({
  grafema,
  slug,
  cuantas: entradas.length,
  ejemplo: ejemplo(grafema),
}));

// Para la regla del apóstrofo: un ejemplo de cada caso, si el diccionario ya los tiene.
const conSaltillo = ejemplo(SALTILLO);
const conGlotalizada = vocabulario.entradas.find((entrada) =>
  letrasDe.get(entrada)?.some((letra) => (glotalizadas as readonly string[]).includes(letra))
);

/** La palabra separada en sus letras: `tx’·o·tx’`. */
const separada = (entrada: Entrada) => (letrasDe.get(entrada) ?? [entrada.mam]).join(' · ');

---

<BaseLayout
  titulo="Gramática"
  descripcion="Las 32 letras del alfabeto Mam, cómo se agrupan y la regla del apóstrofo, con ejemplos del diccionario."
>
  <h1 class="text-3xl">Gramática</h1>

  <p class="mt-4 text-lg text-tinta-suave">
    El alfabeto <span lang="mam">Mam</span> tiene {GRAFEMAS.length} letras. Algunas se escriben
    con dos o tres caracteres, pero son una sola letra:{' '}
    <span lang="mam" class="mam">tx’</span> es una letra, no tres.
  </p>

  <RotuloSeccion titulo="Las 32 letras, en orden" class="mt-10" />

  <p class="mt-3 text-tinta-suave">
    El orden no es el del castellano. Toca una letra para ver las palabras que empiezan con
    ella.
  </p>

  <ol class="mt-4 grid gap-2 sm:grid-cols-2">
    {
      letras.map(({ grafema, slug, cuantas, ejemplo }, indice) => (
        <li class="flex min-h-16 items-center gap-4 rounded-xl border border-borde p-3">
          {cuantas > 0 ? (
            <a
              href={`${base}diccionario/letra/${slug}`}
              lang="mam"
              aria-label={`Letra ${grafema}: ${cuantas} palabra${cuantas === 1 ? '' : 's'}`}
              class="mam inline-flex h-12 min-w-14 shrink-0 items-center justify-center rounded-lg border border-jade/35 px-2 text-2xl font-bold text-jade-hondo no-underline hover:border-jade hover:bg-papel-hondo"
            >
              {grafema}
            </a>
          ) : (
            <span
              lang="mam"
              title="Todavía sin palabras que empiecen con esta letra"
              class="mam inline-flex h-12 min-w-14 shrink-0 items-center justify-center rounded-lg border border-dashed border-borde px-2 text-2xl font-bold text-tinta-suave"
            >
              {grafema}
            </span>
          )}
          <div class="min-w-0">
            <p class="text-sm text-tinta-suave">Letra {indice + 1}</p>
            {ejemplo ? (
              <p>
                <span lang="mam" class="mam text-lg font-bold">
                  {ejemplo.mam}
                </span>{' '}
                <span class="text-tinta-suave">— {ejemplo.espanol}</span>
              </p>
            ) : (
              <p class="text-tinta-suave">Todavía sin ejemplo en el diccionario.</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <RotuloSeccion titulo="Cómo se agrupan" class="mt-10" />

  <dl class="mt-4 flex flex-col gap-4">
    <div>
      <dt class="font-bold">Vocales ({vocales.length})</dt>
      <dd class="mt-1 flex flex-wrap gap-2">
        {vocales.map((g) => <span lang="mam" class="mam text-xl">{g}</span>)}
      </dd>
    </div>
    <div>
      <dt class="font-bold">Letras de dos caracteres ({dobles.length})</dt>
      <dd class="mt-1">
        <span class="flex flex-wrap gap-3">
          {dobles.map((g) => <span lang="mam" class="mam text-xl">{g}</span>)}
        </span>
        <span class="mt-1 block text-tinta-suave">
          Se escriben con dos caracteres y son una sola letra.
        </span>
      </dd>
    </div>
    <div>
      <dt class="font-bold">Glotalizadas ({glotalizadas.length})</dt>
      <dd class="mt-1">
        <span class="flex flex-wrap gap-3">
          {glotalizadas.map((g) => <span lang="mam" class="mam text-xl">{g}</span>)}
        </span>
        <span class="mt-1 block text-tinta-suave">
          Una consonante con apóstrofo. Cada una es una letra distinta de la consonante sola:{' '}
          <span lang="mam" class="mam">t</span> y <span lang="mam" class="mam">t’</span> no son la
          misma letra.
        </span>
      </dd>
    </div>
    <div>
      <dt class="font-bold">Saltillo</dt>
      <dd class="mt-1">
        <span lang="mam" class="mam text-xl">{SALTILLO}</span>
        <span class="mt-1 block text-tinta-suave">
          Es la última letra del alfabeto. Se escribe solo, sin consonante delante.
        </span>
      </dd>
    </div>
  </dl>

  <RotuloSeccion titulo="La regla del apóstrofo" class="mt-10" />

  <div class="mt-4 flex flex-col gap-4">
    <div class="rounded-xl border border-borde p-4">
      <p>
        <strong>Después de una consonante</strong>, el apóstrofo es parte de esa letra: forma una
        glotalizada.
      </p>
      {
        conGlotalizada && (
          <p class="mt-2">
            <span lang="mam" class="mam text-xl font-bold text-jade-hondo">
              {conGlotalizada.mam}
            </span>{' '}
            <span class="text-tinta-suave">— {conGlotalizada.espanol}</span>
            <span class="mt-1 block text-sm text-tinta-suave">
              Letras: <span lang="mam" class="mam">{separada(conGlotalizada)}</span>
            </span>
          </p>
        )
      }
    </div>

    <div class="rounded-xl border border-borde p-4">
      <p>
        <strong>Después de una vocal</strong>, el apóstrofo es el saltillo: una letra por sí misma.
      </p>
      {
        conSaltillo && (
          <p class="mt-2">
            <span lang="mam" class="mam text-xl font-bold text-jade-hondo">
              {conSaltillo.mam}
            </span>{' '}
            <span class="text-tinta-suave">— {conSaltillo.espanol}</span>
            <span class="mt-1 block text-sm text-tinta-suave">
              Letras: <span lang="mam" class="mam">{separada(conSaltillo)}</span>
            </span>
          </p>
        )
      }
    </div>

    <p class="text-tinta-suave">
      Para buscar en el diccionario no hace falta escribir el apóstrofo: «txotx» encuentra{' '}
      <span lang="mam" class="mam">tx’otx’</span>.
    </p>
  </div>

  {
    lecciones.length > 0 && (
      <>
        <RotuloSeccion titulo="Más sobre la gramática" class="mt-10" />
        <ListaDePaginas paginas={lecciones} ruta="gramatica" class="mt-4" />
      </>
    )
  }
</BaseLayout>
