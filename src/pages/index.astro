---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FichaTema from '@/components/FichaTema.astro';
import IconoSeccion from '@/components/IconoSeccion.astro';
import PalabraDelDia from '@/components/PalabraDelDia.astro';
import { DICCIONARIO, ESTILO_RUMBO, RUMBOS, href } from '@/data/secciones';
import { cargarVocabulario, porTema } from '@/data/vocabulario';

/*
 * La portada entra por la pregunta que trae el usuario —«¿cómo se dice…?»— y no por un
 * índice de secciones. Para alguien de primaria, «busca una palabra» es la puerta más clara
 * que hay, y el resto del sitio cabe debajo.
 *
 * El orden es el de docs/rediseno-ui.md: el buscador en el verde del centro, los cuatro
 * rumbos (una sección cada uno, con su palabra de color en Mam), los temas y la palabra del
 * día. En escritorio la palabra del día se va a una columna lateral fija; en teléfono y tableta
 * queda después de los rumbos, antes de la lista larga de temas.
 *
 * OJO CON LA CAJA DE BÚSQUEDA: aquí es un **enlace** al diccionario, no el buscador. El
 * buscador es una isla de React y montarla aquí traería los 52 KB de React a la página más
 * visitada; `scripts/weight.mjs` hace fallar el build justamente por eso. Por ese motivo el
 * enlace dice «Buscar una palabra» y no finge ser un campo con texto de ejemplo dentro: una
 * caja que parece escribible y no lo es se siente rota.
 *
 * La palabra en Mam de cada rumbo va arriba a la derecha, como un sello, y no encima del
 * nombre de la sección: ahí se leería como un rótulo y la sección perdería el primer lugar.
 *
 * Los temas salen del vocabulario real, con sus cuentas. Si el validador lingüístico
 * todavía no aprobó nada, salen todos en cero y eso es lo correcto.
 */
const vocabulario = await cargarVocabulario();
const temas = porTema(vocabulario);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  titulo="Inicio"
  descripcion="Biblioteca Digital en idioma Mam para la preservación lingüística y cultural."
  ancho="panel"
>
  <div class="grid gap-x-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="lg:col-start-1">
      <h1 class="text-4xl leading-tight md:text-5xl">
        Biblioteca Digital <span lang="mam">Mam</span>
      </h1>

      <p class="mt-3 max-w-[60ch] text-tinta-suave">
        Biblioteca Digital en idioma <span lang="mam">Mam</span> para la preservación
        lingüística y cultural.
      </p>

      <a
        href={href(DICCIONARIO, base)}
        class="tocable mt-6 flex min-h-14 max-w-xl items-center gap-3 rounded-full bg-verde-campo px-5 text-lg font-bold text-verde-texto no-underline [--tocable-sombra:var(--color-verde)]"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          aria-hidden="true"
          class="shrink-0"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M16.5 16.5 21 21"></path>
        </svg>
        Buscar una palabra
      </a>

      <p class="mt-3 max-w-xl text-base text-tinta-suave">
        En <span lang="mam">Mam</span> o en castellano, sin saltillo ni diéresis: «xiky»
        encuentra <span lang="mam" class="mam">ẍiky</span>.
      </p>

      <nav aria-label="Secciones" class="mt-8">
        <ul class="grid grid-cols-2 gap-3 md:grid-cols-4">
          {
            RUMBOS.map((seccion) => {
              const estilo = ESTILO_RUMBO[seccion.rumbo];
              return (
                <li>
                  <a
                    href={href(seccion, base)}
                    class:list={[
                      'tocable flex h-full min-h-28 flex-col justify-between gap-3 rounded-2xl p-3.5 no-underline',
                      estilo.campo,
                      estilo.sombra,
                    ]}
                  >
                    <span class="flex items-start justify-between gap-2">
                      <IconoSeccion d={seccion.icono} tamano={26} />
                      <span lang="mam" class="mam text-base opacity-80">
                        {seccion.palabraMam}
                      </span>
                    </span>
                    <span>
                      <span class="block text-lg leading-tight font-bold">{seccion.nombre}</span>
                      <span class="block text-base">{seccion.descripcion}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <div class="mt-8 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-2">
      <div class="lg:sticky lg:top-6">
        <PalabraDelDia entradas={vocabulario.entradas} categorias={vocabulario.categorias} />
      </div>
    </div>

    <section aria-labelledby="temas-titulo" class="mt-10 lg:col-start-1">
      <h2 id="temas-titulo" class="text-2xl">Escoge un tema</h2>
      <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3">
        {
          temas.map(({ categoria, entradas }) => (
            <li>
              <FichaTema categoria={categoria} cantidad={entradas.length} />
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex items-start gap-3 rounded-2xl bg-papel-hondo p-4">
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="mt-0.5 shrink-0 text-verde-texto"
        >
          <path d="M12 20.5v-.01"></path>
          <path d="M8.2 16.6a5.4 5.4 0 0 1 7.6 0"></path>
          <path d="M4.8 12.9a10.2 10.2 0 0 1 14.4 0"></path>
          <path d="M1.6 9.3a15 15 0 0 1 20.8 0"></path>
        </svg>
        <div>
          <p class="font-bold">Funciona sin internet</p>
          <p class="mt-1 text-base text-tinta-suave">
            El diccionario se guarda en tu teléfono la primera vez que lo abres. Los videos sí
            necesitan señal.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
