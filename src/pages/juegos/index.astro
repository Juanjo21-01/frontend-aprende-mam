---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CabeceraSeccion from '@/components/CabeceraSeccion.astro';
import IconoSeccion from '@/components/IconoSeccion.astro';
import IconoTema from '@/components/IconoTema.astro';
import { JUEGOS as SECCION_JUEGOS } from '@/data/secciones';
import { ICONOS_JUEGOS } from '@/data/iconos-juegos';
import { temaVisual } from '@/data/temas';
import { cargarVocabulario, porTema } from '@/data/vocabulario';
import { JUEGOS, MINIMO_POR_TEMA, TODOS, temasJugables } from '@/data/juegos';

const vocabulario = await cargarVocabulario();
const grupos = porTema(vocabulario);
const secciones = JUEGOS.map((juego) => ({ juego, jugables: temasJugables(grupos, juego.slug) }));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  titulo="Juegos"
  descripcion="Memoria, sopa de letras y cuestionario para practicar el vocabulario Mam por tema."
>
  <CabeceraSeccion seccion={SECCION_JUEGOS} titulo="Juegos">
    <p>Elige un juego y después un tema. Practica a tu ritmo, sin límite de tiempo.</p>
  </CabeceraSeccion>

  <div class="mt-8 grid items-start gap-6 lg:grid-cols-3">
    {secciones.map(({ juego, jugables }) => (
      <details class="group min-w-0">
        <summary class="tocable list-none rounded-2xl bg-rojo-campo p-5 text-rojo-texto hover:bg-rojo-tinte [--tocable-sombra:var(--color-rojo)] [&::-webkit-details-marker]:hidden">
          <h2 aria-label={juego.nombre} class="grid grid-cols-[2.5rem_1fr_1.25rem] items-center gap-x-3 gap-y-2">
            <IconoSeccion d={ICONOS_JUEGOS[juego.slug]} tamano={32} />
            <span class="text-2xl leading-tight">{juego.nombre}</span>
            <svg class="group-open:rotate-180" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            <span class="col-span-3 text-lg font-normal leading-normal lg:min-h-22">{juego.descripcion}</span>
            <span class="col-span-3 mt-1 text-base underline underline-offset-4 group-open:hidden">Elegir tema</span>
            <span class="col-span-3 mt-1 hidden text-base underline underline-offset-4 group-open:block">Cerrar temas</span>
          </h2>
        </summary>

        <div class="px-1 pt-6">
          {juego.listo && jugables.length > 0 ? (
            <>
              <p class="mb-2 font-bold">¿Qué tema quieres practicar?</p>
              <ul class="divide-y divide-borde">
                {jugables.map(({ categoria }) => {
                  const visual = temaVisual(categoria.slug);
                  return (
                    <li>
                      <a href={`${base}juegos/${juego.slug}/${categoria.slug}`} class="flex min-h-16 items-center gap-3 rounded-lg px-2 py-3 no-underline hover:bg-papel-hondo">
                        <span class:list={['grid size-10 shrink-0 place-items-center rounded-xl', visual.chip]}><IconoTema slug={categoria.slug} tamano={25} /></span>
                        <span class="min-w-0 flex-1 font-bold">{categoria.nombre_es}</span>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"></path></svg>
                      </a>
                    </li>
                  );
                })}
                {jugables.length > 1 && (
                  <li><a href={`${base}juegos/${juego.slug}/${TODOS}`} class="flex min-h-14 items-center px-2 py-3 font-bold text-rojo-texto underline">Mezclar todos los temas</a></li>
                )}
              </ul>
            </>
          ) : (
            <p class="rounded-2xl bg-papel-hondo p-4 text-tinta-suave">{juego.listo ? `Todavía no hay palabras suficientes para este juego. Cada tema necesita al menos ${MINIMO_POR_TEMA} palabras aptas y revisadas.` : 'Este juego todavía está en preparación.'}</p>
          )}
        </div>
      </details>
    ))}
  </div>

  <p class="mt-10 max-w-[68ch] text-base text-tinta-suave">
    Después de la primera visita, estos juegos quedan guardados y puedes seguir practicando sin internet.
  </p>
</BaseLayout>
