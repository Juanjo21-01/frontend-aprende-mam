<BaseLayout
  titulo="Juegos"
  descripcion="Actividades para practicar vocabulario Mam, tres de ellas funcionan sin conexión."
>
  <PlaceholderSection
    titulo="Juegos"
    resumen="Actividades para practicar el vocabulario aprendido."
