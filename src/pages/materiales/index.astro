---
/**
 * Material didáctico: los PDF que el docente descarga, guarda e imprime.
 *
 * Los PDF NO se precachean (CLAUDE.md: revientan la cuota de almacenamiento, y el service worker
 * los deja pasar). Se bajan cuando el usuario toca el enlace, y la página lo dice con el tamaño
 * por delante para que la decisión de gastar datos sea suya.
 *
 * Cada documento puede llevar un video de apoyo; sale con el mismo `ContenidoExterno` de todo el
 * sitio, así que sin señal se degrada a un aviso y no a un marco vacío.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CabeceraSeccion from '@/components/CabeceraSeccion.astro';
import { MATERIALES } from '@/data/secciones';
import DocumentoFicha from '@/components/DocumentoFicha.astro';
import PlaceholderSection from '@/components/PlaceholderSection.astro';
import RotuloSeccion from '@/components/RotuloSeccion.astro';
import { cargarContenido, documentosEnOrden } from '@/data/contenido';
import { TIPOS_DOCUMENTO, type TipoDocumento } from '@/data/contenido-esquema';

const documentos = documentosEnOrden(await cargarContenido());

const TIPOS: Record<TipoDocumento, string> = {
  guia: 'Guías didácticas',
  ficha: 'Fichas de trabajo',
  cuadernillo: 'Cuadernillos de ejercicios',
  infografia: 'Infografías',
};

const grupos = TIPOS_DOCUMENTO.map((tipo) => ({
  tipo,
  titulo: TIPOS[tipo],
  documentos: documentos.filter((documento) => documento.tipo === tipo),
})).filter((grupo) => grupo.documentos.length > 0);

---

<BaseLayout
  titulo="Materiales"
  descripcion="Guías didácticas, fichas de trabajo, cuadernillos e infografías descargables para trabajar el idioma Mam en el aula."
>
  {
    documentos.length === 0 ? (
      <PlaceholderSection seccion={MATERIALES}
        titulo="Material didáctico"
        resumen="Recursos que el docente puede descargar, guardar e imprimir para trabajar en el aula, con o sin conexión."
        pendiente={[
          'Guías didácticas, fichas de trabajo, cuadernillos de ejercicios e infografías en PDF.',
          'Videos de apoyo para la clase. Necesitan conexión.',
          'Cada documento con su fuente y su licencia de uso.',
          'Los PDF se descargan solo cuando los pides, para no gastar tus datos.',
        ]}
      />
    ) : (
      <>
        <CabeceraSeccion seccion={MATERIALES} titulo="Material didáctico">
        <p>
          Recursos para descargar, guardar e imprimir y trabajar en el aula. Cada PDF se baja solo
          cuando lo pides, para no gastar tus datos.
        </p>
        </CabeceraSeccion>

        {grupos.map((grupo) => (
          <section class="mt-10">
            <RotuloSeccion titulo={grupo.titulo} />

            <ul class="mt-4 flex flex-col gap-4">
              {grupo.documentos.map((documento) => (
                <li><DocumentoFicha documento={documento} /></li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )
  }
</BaseLayout>
