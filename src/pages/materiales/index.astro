---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaceholderSection from '@/components/PlaceholderSection.astro';
---

<BaseLayout
  titulo="Materiales"
  descripcion="Guías didácticas, fichas de trabajo, cuadernillos e infografías descargables para trabajar el idioma Mam en el aula."
>
  <PlaceholderSection
    titulo="Material didáctico"
    resumen="Recursos que el docente puede descargar, guardar e imprimir para trabajar en el aula, con o sin conexión."
    pendiente={[
      'Guías didácticas, fichas de trabajo, cuadernillos de ejercicios e infografías en PDF.',
      'Videos de apoyo para la clase. Necesitan conexión.',
      'Cada documento con su fuente y su licencia de uso.',
      'Los PDF se descargan solo cuando los pides, para no gastar tus datos.',
    ]}
  />
</BaseLayout>
