{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Astro traduce estos `paths` a alias de Vite por su cuenta, así que sirven igual en el
    // editor y en el build. Una sola raíz (`@/` = `src/`) y no un alias por carpeta: mover un
    // archivo de sitio no obliga a inventar un alias nuevo.
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro"],
  "exclude": ["dist"]
}
